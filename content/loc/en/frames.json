 },
 "frame.assault": {
  "verb": ["beat", "hit", "thrash"],
  "noun": "lex.noun.assault",
  "roles": {"doer": "nom", "victim": "acc"},
  "clause": ["{doer} {time?} {verb:agree=doer} {victim?}",
             "{doer} {verb:agree=doer} {victim?} {place?}",
             "{time?} {doer} {verb:agree=doer} {victim?} out of nowhere"],
  "nominal": "the {noun} {victim?:prep|of}",
  "about": "about the {noun} {victim?:prep|of}"
 },
 "frame.murder": {
  "verb": ["kill", "kill_knife", "kill_finish"],
  "noun": "lex.noun.murder",
  "roles": {"doer": "nom", "victim": "acc"},
  "clause": ["{doer} {time?} {verb:agree=doer} {victim}",
             "{doer} {verb:agree=doer} {victim} {place?}",
             "{time?} {doer} {verb:agree=doer} {victim} in cold blood"],
  "nominal": "the {noun} of {victim}",
  "about": "about the {noun} of {victim}"
 },
 "frame.help": {
  "verb": ["help", "help_out"],
  "noun": "lex.noun.help",
  "roles": {"doer": "nom", "beneficiary": "acc", "object": "with+acc"},
  "clause": ["{doer} {verb:agree=doer} {beneficiary?} {object?}",
             "{doer} {time?} {verb:agree=doer} {beneficiary?} {object?}"],
  "nominal": "the {noun} given {beneficiary?:prep|to} {object?}",
  "about": "about the {noun} given {beneficiary?:prep|to}"
 },
 "frame.give": {
  "verb": ["give", "give_away"],
  "noun": "lex.noun.gift",
  "roles": {"doer": "nom", "beneficiary": "to+acc", "object": "acc"},
  "clause": ["{doer} {verb:agree=doer} {object?} {beneficiary?}",
             "{doer} {time?} {verb:agree=doer} {object?} {beneficiary?}"],
  "nominal": "the {noun} {beneficiary?}",
  "about": "about the {noun} {beneficiary?}"
 },
 "frame.say": {
  "verb": ["say", "tell"],
  "noun": "lex.noun.word",
  "roles": {"speaker": "nom", "listener": "to+acc", "content": "clause"},
  "clause": ["{speaker} {verb:agree=speaker} {listener?} that {>content:clause}",
             "{speaker} {verb:agree=speaker} {listener?} that {>content:clause}, or so it goes"],
  "nominal": "the words of {speaker:acc}",
  "about": "{>content:about}"
 },
 "frame.think": {
  "verb": ["think", "reckon"],
  "noun": "lex.noun.thought",
  "roles": {"thinker": "nom", "content": "clause"},
  "clause": ["{thinker} {verb:agree=thinker} that {>content:clause}",
             "{thinker} {verb:agree=thinker} {>content:clause}"],
  "nominal": "the {noun} of {thinker:acc}",
  "about": "{>content:about}"
 }
}
