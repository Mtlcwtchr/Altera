{
  "_doc": "Пробы слоя Utility: состояние blackboard → ожидаемая цель-лидер (expect_top — допустимые). Для юнит-тестов A (altera_sim_tests) и для сверки кривых. need: 1 = удовлетворена. home/has — количества.",
  "probes": [
    {"id": "hungry_day_home_full",   "bb": {"need": {"hunger": 0.25}, "home": {"household_idol": 1, "meal": 3, "roots": 6, "firewood": 6}}, "expect_top": ["eat"]},
    {"id": "tired_night",            "bb": {"night": true, "need": {"energy": 0.35}, "home": {"household_idol": 1, "meal": 3, "roots": 6, "firewood": 6}}, "expect_top": ["sleep"]},
    {"id": "cold_evening",           "bb": {"need": {"warmth": 0.2}, "home": {"household_idol": 1, "meal": 3, "firewood": 6}}, "expect_top": ["get_warm"]},
    {"id": "fed_rested_empty_store", "bb": {"home": {"household_idol": 1, "meal": 0, "roots": 0, "firewood": 8}, "has": {"axe": 1, "tunic": 1}}, "expect_top": ["stock_food"]},
    {"id": "no_firewood",            "bb": {"home": {"household_idol": 1, "meal": 6, "roots": 12, "firewood": 0}, "has": {"axe": 1, "tunic": 1}, "need": {"warmth": 0.6}}, "expect_top": ["stock_firewood"]},
    {"id": "homeless_with_axe",      "bb": {"home": {}, "has": {"axe": 1, "tunic": 1}}, "expect_top": ["build_home"]},
    {"id": "homeless_no_axe",        "bb": {"home": {}, "has": {"tunic": 1}}, "expect_top": ["build_home", "make_axe"]},
    {"id": "lonely",                 "bb": {"need": {"social": 0.15}, "home": {"household_idol": 1, "meal": 6, "roots": 12, "firewood": 12}, "has": {"axe": 1, "tunic": 1}}, "expect_top": ["socialize"]},
    {"id": "hungry_nothing_at_home", "bb": {"need": {"hunger": 0.22}, "home": {"household_idol": 1, "meal": 0, "roots": 0, "firewood": 6}}, "expect_top": ["eat"], "_doc": "eat всё равно лидирует; ask_help — второй, он и даст разговор, если методы eat провалятся"},
    {"id": "all_good",               "bb": {"home": {"household_idol": 1, "meal": 6, "roots": 12, "firewood": 12, "axe": 1}, "has": {"axe": 1, "tunic": 1}}, "expect_top": ["idle", "have_fun", "share_food", "socialize", "offer_trade"]},
    {"id": "lazy_empty_store",       "bb": {"traits": ["lazy"], "body": {"fatigue": 0.75}, "home": {"household_idol": 1, "meal": 1, "roots": 2, "firewood": 8}, "has": {"axe": 1, "tunic": 1}}, "expect_top": ["rest"]},
    {"id": "diligent_empty_store",   "bb": {"traits": ["diligent"], "body": {"fatigue": 0.75}, "home": {"household_idol": 1, "meal": 1, "roots": 2, "firewood": 8}, "has": {"axe": 1, "tunic": 1}}, "expect_top": ["stock_food"]},
    {"id": "no_clothes_autumn",      "bb": {"need": {"warmth": 0.5}, "home": {"household_idol": 1, "meal": 6, "roots": 12, "firewood": 12}, "has": {"axe": 1}}, "expect_top": ["make_clothes"]}
  ]
}
