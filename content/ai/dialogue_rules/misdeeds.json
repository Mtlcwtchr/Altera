  {"id": "greet.bad_name.notoriety", "when": ["act=greet", "!memory.deed", "reputation.notoriety>=0.5"], "say": "say.greet.bad_name", "weight": 1.5, "cooldown": "pair:2d"},
  {"id": "greet.good_name.generosity", "when": ["act=greet", "reputation.generosity>=0.4", "rel.enmity<0.3"], "say": "say.greet.good_name", "cooldown": "pair:2d"},
  {"id": "greet.good_name.valor", "when": ["act=greet", "reputation.valor>=0.5", "rel.enmity<0.3"], "say": "say.greet.good_name", "cooldown": "pair:2d"},
  {"id": "greet.pious_name", "when": ["act=greet", "reputation.piety>=0.5", "rel.enmity<0.3"], "say": "say.greet.pious_name", "cooldown": "pair:2d"},
  {"id": "greet.helped_me.was_given_food", "when": ["act=greet", "memory.was_given_food", "rel.enmity<0.3"], "say": "say.greet.helped_me", "cooldown": "pair:2d"},
  {"id": "greet.helped_me.was_comforted", "when": ["act=greet", "memory.was_comforted", "rel.enmity<0.3"], "say": "say.greet.helped_me", "cooldown": "pair:2d"},
  {"id": "greet.helped_me.was_treated", "when": ["act=greet", "memory.was_treated", "rel.enmity<0.3"], "say": "say.greet.helped_me", "cooldown": "pair:2d"},
  {"id": "greet.helped_me.was_given_gift", "when": ["act=greet", "memory.was_given_gift", "rel.enmity<0.3"], "say": "say.greet.helped_me", "cooldown": "pair:2d"},
