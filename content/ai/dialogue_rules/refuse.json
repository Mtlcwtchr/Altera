{
 "_doc": "Отказы с причиной и реплики на неудачу шанса (AL-36: ни одного пустого «ок»). reason — код причины отказа (те же, что reason.* в loc/dialogue.json, плюс misdeed: причина — проступок слушателя, аргумент reason — его пропозиция). outcome=fail — шанс не прошёл; intent — план разговора, reply_to — на какой акт ответ. Факты ставит вызывающий (T6).",
 "rules": [
  {"id": "refuse.reason.busy", "when": ["act=refuse", "reason=busy"], "say": "say.refuse.busy"},
  {"id": "refuse.reason.enmity", "when": ["act=refuse", "reason=enmity"], "say": "say.refuse.enmity"},
  {"id": "refuse.reason.fear_of_law", "when": ["act=refuse", "reason=fear_of_law"], "say": "say.refuse.fear_of_law"},
  {"id": "refuse.reason.honest", "when": ["act=refuse", "reason=honest"], "say": "say.refuse.honest"},
  {"id": "refuse.reason.hungry", "when": ["act=refuse", "reason=hungry"], "say": "say.refuse.hungry"},
  {"id": "refuse.reason.low_affinity", "when": ["act=refuse", "reason=low_affinity"], "say": "say.refuse.low_affinity"},
  {"id": "refuse.reason.low_trust", "when": ["act=refuse", "reason=low_trust"], "say": "say.refuse.low_trust"},
  {"id": "refuse.reason.loyalty_other", "when": ["act=refuse", "reason=loyalty_other"], "say": "say.refuse.loyalty_other"},
  {"id": "refuse.reason.no_authority", "when": ["act=refuse", "reason=no_authority"], "say": "say.refuse.no_authority"},
  {"id": "refuse.reason.no_item", "when": ["act=refuse", "reason=no_item"], "say": "say.refuse.no_item"},
  {"id": "refuse.reason.taboo", "when": ["act=refuse", "reason=taboo"], "say": "say.refuse.taboo"},
  {"id": "refuse.reason.tired", "when": ["act=refuse", "reason=tired"], "say": "say.refuse.tired"},
  {"id": "refuse.reason.too_costly", "when": ["act=refuse", "reason=too_costly"], "say": "say.refuse.too_costly"},
  {"id": "refuse.reason.unfair_terms", "when": ["act=refuse", "reason=unfair_terms"], "say": "say.refuse.unfair_terms"},
  {"id": "refuse.reason.unknown_topic", "when": ["act=refuse", "reason=unknown_topic"], "say": "say.refuse.unknown_topic"},
  {"id": "refuse.misdeed", "when": ["act=refuse", "reason=misdeed"], "say": "say.refuse.misdeed", "weight": 2.0},
  {"id": "refuse.memory.saw_crime", "when": ["act=refuse", "memory.saw_crime", "memory.deed", "memory.wariness>=0.15"], "say": "say.refuse.enmity", "weight": 1.0},
  {"id": "refuse.memory.told_crime", "when": ["act=refuse", "memory.told_crime", "memory.deed", "memory.wariness>=0.15"], "say": "say.refuse.enmity", "weight": 1.0},
  {"id": "refuse.memory.was_robbed", "when": ["act=refuse", "memory.was_robbed", "memory.deed", "memory.wariness>=0.15"], "say": "say.refuse.enmity", "weight": 1.0},
  {"id": "refuse.memory.saw_attack", "when": ["act=refuse", "memory.saw_attack", "memory.deed", "memory.wariness>=0.15"], "say": "say.refuse.enmity", "weight": 1.0},
  {"id": "refuse.memory.was_insulted", "when": ["act=refuse", "!memory.deed", "memory.was_insulted"], "say": "say.refuse.enmity", "weight": 0.3},
  {"id": "refuse.tired.state", "when": ["act=refuse", "speaker.state=tired"], "say": "say.refuse.tired"},
  {"id": "refuse.low_trust.rel", "when": ["act=refuse", "rel.trust<0.15"], "say": "say.refuse.low_trust", "weight": 0.5},
  {"id": "refuse.enmity.rel", "when": ["act=refuse", "rel.enmity>=0.5"], "say": "say.refuse.enmity", "weight": 0.5},
  {"id": "outcome.fail.recruit", "when": ["act=refuse", "outcome=fail", "intent=recruit"], "say": "say.outcome.fail.recruit"},
  {"id": "outcome.fail.court", "when": ["act=refuse", "outcome=fail", "intent=court"], "say": "say.outcome.fail.court"},
  {"id": "outcome.fail.ask_favor", "when": ["act=refuse", "outcome=fail", "intent=ask_favor"], "say": "say.outcome.fail.request"},
  {"id": "outcome.fail.propose_trade", "when": ["act=refuse", "outcome=fail", "intent=propose_trade"], "say": "say.outcome.fail.bargain"},
  {"id": "outcome.fail.act.persuade", "when": ["act=refuse", "outcome=fail", "reply_to=persuade"], "say": "say.outcome.fail.persuade"},
  {"id": "outcome.fail.act.bargain", "when": ["act=refuse", "outcome=fail", "reply_to=bargain"], "say": "say.outcome.fail.bargain"},
  {"id": "outcome.fail.act.threaten", "when": ["act=refuse", "outcome=fail", "reply_to=threaten"], "say": "say.outcome.fail.threaten"},
  {"id": "outcome.fail.act.request", "when": ["act=refuse", "outcome=fail", "reply_to=request"], "say": "say.outcome.fail.request"},
  {"id": "outcome.fail.act.praise", "when": ["act=refuse", "outcome=fail", "reply_to=praise"], "say": "say.outcome.fail.court"},
  {"id": "outcome.fail.any", "when": ["act=refuse", "outcome=fail"], "say": "say.outcome.fail.any"}
 ]
}
