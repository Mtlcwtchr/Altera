{
 "_doc": "Правила выбора реплик-содержаний (AL-51): акты с пропозицией (критерий pred — содержание есть), по эпистемике (§3.2: seen/told/heard/rumor по полосам уверенности/guess/inferred), по ролям слушателя/говорящего, по месту и регистру (ты/вы по статусу §11.2). Ключи say.* — content/loc/<lang>/say.json.",
 "rules": [
  {"id": "inform.seen", "when": ["act=inform", "pred", "epi.source=seen"], "say": "say.inform.seen", "once_per": "listener+topic"},
  {"id": "inform.seen.victim", "when": ["act=inform", "pred", "epi.source=seen", "listener.is_victim"], "say": "say.inform.seen_victim", "once_per": "listener+topic"},
  {"id": "inform.seen.victim_family", "when": ["act=inform", "pred", "epi.source=seen", "listener.is_victim_family"], "say": "say.inform.seen_victim", "once_per": "listener+topic"},
  {"id": "inform.told", "when": ["act=inform", "pred", "epi.source=told|heard", "epi.hops>=1"], "say": "say.inform.told", "once_per": "listener+topic"},
  {"id": "inform.heard", "when": ["act=inform", "pred", "epi.source=told|heard"], "say": "say.inform.heard", "once_per": "listener+topic"},
  {"id": "inform.rumor.hi", "when": ["act=inform", "pred", "epi.source=rumor", "epi.conf>=0.6"], "say": "say.inform.rumor_hi", "once_per": "listener+topic", "cooldown": "speaker:1d"},
  {"id": "inform.rumor.mid", "when": ["act=inform", "pred", "epi.source=rumor", "epi.conf>=0.4", "epi.conf<0.6"], "say": "say.inform.rumor_mid", "once_per": "listener+topic", "cooldown": "speaker:1d"},
  {"id": "inform.rumor.lo", "when": ["act=inform", "pred", "epi.source=rumor", "epi.conf<0.4"], "say": "say.inform.rumor_lo", "once_per": "listener+topic", "cooldown": "speaker:1d"},
  {"id": "inform.rumor.grave", "when": ["act=inform", "pred=murder|assault", "epi.source=rumor|told|heard", "epi.conf>=0.4"], "say": "say.inform.grave_rumor", "once_per": "listener+topic", "weight": 1.5},
  {"id": "inform.guess", "when": ["act=inform", "pred", "modality=guess"], "say": "say.inform.guess", "once_per": "listener+topic"},
  {"id": "inform.guess.theft", "when": ["act=inform", "pred", "modality=guess", "pred.tag=theft"], "say": "say.inform.guess_theft", "once_per": "listener+topic"},
  {"id": "inform.inferred", "when": ["act=inform", "pred", "epi.source=inferred"], "say": "say.inform.inferred", "once_per": "listener+topic"},
  {"id": "inform.loss", "when": ["act=inform", "pred=lose", "epi.source=seen|told|heard"], "say": "say.inform.loss", "once_per": "listener+topic"},
  {"id": "lie.assert", "when": ["act=lie", "pred"], "say": "say.lie.assert"},
  {"id": "lie.deny", "when": ["act=lie", "pred", "neg"], "say": "say.lie.deny"},
  {"id": "lie.deny.accused", "when": ["act=lie", "pred", "speaker.is_doer"], "say": "say.lie.deny"},
  {"id": "ask.about", "when": ["act=ask", "pred"], "say": "say.ask.about"},
  {"id": "ask.about.rude", "when": ["act=ask", "pred", "tone=hostile|cold"], "say": "say.ask.about_rude"},
  {"id": "ask.about.enmity", "when": ["act=ask", "pred", "rel.enmity>=0.3"], "say": "say.ask.about_rude"},
  {"id": "ask.about.noble", "when": ["act=ask", "pred", "listener.status=noble"], "say": "say.ask.about_noble"},
  {"id": "accuse.direct", "when": ["act=accuse", "pred"], "say": "say.accuse.direct"},
  {"id": "accuse.direct.doer", "when": ["act=accuse", "pred", "listener.is_doer"], "say": "say.accuse.direct"},
  {"id": "accuse.victim", "when": ["act=accuse", "pred", "listener.is_doer", "speaker.is_victim"], "say": "say.accuse.victim", "weight": 2.0},
  {"id": "accuse.victim_family", "when": ["act=accuse", "pred", "listener.is_doer", "speaker.is_victim_family"], "say": "say.accuse.victim", "weight": 1.5},
  {"id": "accuse.seen", "when": ["act=accuse", "pred", "listener.is_doer", "epi.source=seen"], "say": "say.accuse.seen"},
  {"id": "accuse.unsure", "when": ["act=accuse", "pred", "listener.is_doer", "epi.conf<0.5"], "say": "say.accuse.unsure", "weight": 1.5},
  {"id": "accuse.hostile", "when": ["act=accuse", "pred", "listener.is_doer", "tone=hostile"], "say": "say.accuse.hostile"},
  {"id": "accuse.angry", "when": ["act=accuse", "pred", "listener.is_doer", "speaker.state=angry"], "say": "say.accuse.hostile"},
  {"id": "accuse.public", "when": ["act=accuse", "pred", "listener.is_doer", "place=court|square|tavern"], "say": "say.accuse.public"},
  {"id": "accuse.public.court", "when": ["act=accuse", "pred", "listener.is_doer", "place=court", "epi.conf>=0.5"], "say": "say.accuse.public", "weight": 3.0},
  {"id": "confess.prop", "when": ["act=confess", "pred"], "say": "say.confess.prop"},
  {"id": "confess.familiar", "when": ["act=confess", "pred", "rel.affinity>=0.4"], "say": "say.confess.familiar"},
  {"id": "apologize.prop", "when": ["act=apologize", "pred"], "say": "say.apologize.prop"},
  {"id": "apologize.noble", "when": ["act=apologize", "pred", "listener.status=noble"], "say": "say.apologize.noble"},
  {"id": "thank.prop", "when": ["act=thank", "pred"], "say": "say.thank.prop"},
  {"id": "praise.prop", "when": ["act=praise", "pred=help|give"], "say": "say.praise.prop"},
  {"id": "threaten.secret", "when": ["act=threaten", "pred"], "say": "say.threaten.secret"},
  {"id": "greet.noble", "when": ["act=greet", "listener.status=noble", "speaker.status!=noble"], "say": "say.greet.noble", "weight": 2.0},
  {"id": "greet.clergy", "when": ["act=greet", "listener.status=clergy"], "say": "say.greet.clergy", "weight": 2.0},
  {"id": "greet.elder", "when": ["act=greet", "listener.age=old", "rel.enmity<0.3"], "say": "say.greet.elder"},
  {"id": "greet.child", "when": ["act=greet", "listener.age=child", "speaker.age!=child"], "say": "say.greet.child"},
  {"id": "farewell.noble", "when": ["act=farewell", "listener.status=noble", "speaker.status!=noble"], "say": "say.farewell.noble", "weight": 2.0},
  {"id": "refuse.noble", "when": ["act=refuse", "listener.status=noble", "speaker.status!=noble"], "say": "say.refuse.noble"}
 ]
}
