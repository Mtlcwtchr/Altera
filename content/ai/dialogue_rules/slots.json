{
 "_doc": "Правила частей реплики (slot=<имя>, DIALOGUE_GEN §5.4, §6.3; договорено с T2): noise.open — оговорки по состоянию (speaker.state из мудлетов, states.json) и неуверенности; voice.open/voice.tail — голос черты и возраста (кулдаун, чтобы черта не лезла в каждую фразу); tone.open/tone.tail — тон. Нет подходящего правила — часть пустая. Сборка: noise.open + tone.open|voice.open + реплика + voice.tail|tone.tail (T6).",
 "rules": [
  {"id": "noise.drunk", "when": ["slot=noise.open", "speaker.state=drunk"], "say": "slot.noise.drunk", "weight": 1.0},
  {"id": "noise.scared", "when": ["slot=noise.open", "speaker.state=scared"], "say": "slot.noise.scared", "weight": 1.0},
  {"id": "noise.tired", "when": ["slot=noise.open", "speaker.state=tired"], "say": "slot.noise.tired", "weight": 1.0},
  {"id": "noise.angry", "when": ["slot=noise.open", "speaker.state=angry"], "say": "slot.noise.angry", "weight": 1.0},
  {"id": "noise.hungover", "when": ["slot=noise.open", "speaker.state=hungover"], "say": "slot.noise.hungover", "weight": 1.0},
  {"id": "noise.unsure", "when": ["slot=noise.open", "epi.conf<0.35", "pred"], "say": "slot.noise.unsure", "weight": 0.5},
  {"id": "voice.open.sociable", "when": ["slot=voice.open", "speaker.trait=sociable", "act=inform"], "say": "slot.voice.sociable.open", "cooldown": "speaker:6h"},
  {"id": "voice.open.loner", "when": ["slot=voice.open", "speaker.trait=loner"], "say": "slot.voice.loner.open", "cooldown": "speaker:6h"},
  {"id": "voice.open.proud", "when": ["slot=voice.open", "speaker.trait=proud"], "say": "slot.voice.proud.open", "cooldown": "speaker:6h"},
  {"id": "voice.open.honest", "when": ["slot=voice.open", "speaker.trait=honest"], "say": "slot.voice.honest.open", "cooldown": "speaker:6h"},
  {"id": "voice.open.unscrupulous", "when": ["slot=voice.open", "speaker.trait=unscrupulous"], "say": "slot.voice.unscrupulous.open", "cooldown": "speaker:6h"},
  {"id": "voice.open.lazy", "when": ["slot=voice.open", "speaker.trait=lazy"], "say": "slot.voice.lazy.open", "cooldown": "speaker:6h"},
  {"id": "voice.open.diligent", "when": ["slot=voice.open", "speaker.trait=diligent"], "say": "slot.voice.diligent.open", "cooldown": "speaker:6h"},
  {"id": "voice.open.slob", "when": ["slot=voice.open", "speaker.trait=slob"], "say": "slot.voice.slob.open", "cooldown": "speaker:6h"},
  {"id": "voice.tail.sociable", "when": ["slot=voice.tail", "speaker.trait=sociable", "act=inform"], "say": "slot.voice.sociable.tail", "cooldown": "speaker:6h"},
  {"id": "voice.tail.pious", "when": ["slot=voice.tail", "speaker.trait=pious"], "say": "slot.voice.pious.tail", "cooldown": "speaker:6h"},
  {"id": "voice.tail.curious", "when": ["slot=voice.tail", "speaker.trait=curious"], "say": "slot.voice.curious.tail", "cooldown": "speaker:6h"},
  {"id": "voice.tail.gluttonous", "when": ["slot=voice.tail", "speaker.trait=gluttonous"], "say": "slot.voice.gluttonous.tail", "cooldown": "speaker:6h"},
  {"id": "voice.tail.family_minded", "when": ["slot=voice.tail", "speaker.trait=family_minded"], "say": "slot.voice.family_minded.tail", "cooldown": "speaker:6h"},
  {"id": "voice.tail.stubborn", "when": ["slot=voice.tail", "speaker.trait=stubborn"], "say": "slot.voice.stubborn.tail", "cooldown": "speaker:6h"},
  {"id": "voice.tail.fickle", "when": ["slot=voice.tail", "speaker.trait=fickle"], "say": "slot.voice.fickle.tail", "cooldown": "speaker:6h"},
  {"id": "voice.tail.generous", "when": ["slot=voice.tail", "speaker.trait=generous"], "say": "slot.voice.generous.tail", "cooldown": "speaker:6h"},
  {"id": "voice.tail.fastidious", "when": ["slot=voice.tail", "speaker.trait=fastidious"], "say": "slot.voice.fastidious.tail", "cooldown": "speaker:6h"},
  {"id": "voice.open.old", "when": ["slot=voice.open", "speaker.age=old"], "say": "slot.voice.old.open", "cooldown": "speaker:6h"},
  {"id": "voice.open.child", "when": ["slot=voice.open", "speaker.age=child"], "say": "slot.voice.child.open", "cooldown": "speaker:6h"},
  {"id": "tone.open.polite", "when": ["slot=tone.open", "tone=polite"], "say": "slot.tone.polite.open"},
  {"id": "tone.open.warm", "when": ["slot=tone.open", "tone=warm"], "say": "slot.tone.warm.open"},
  {"id": "tone.open.cold", "when": ["slot=tone.open", "tone=cold"], "say": "slot.tone.cold.open"},
  {"id": "tone.open.pleading", "when": ["slot=tone.open", "tone=pleading"], "say": "slot.tone.pleading.open"},
  {"id": "tone.tail.hostile", "when": ["slot=tone.tail", "tone=hostile"], "say": "slot.tone.hostile.tail"},
  {"id": "tone.tail.playful", "when": ["slot=tone.tail", "tone=playful"], "say": "slot.tone.playful.tail"},
  {"id": "tone.open.noble", "when": ["slot=tone.open", "listener.status=noble", "speaker.status!=noble"], "say": "slot.tone.noble.open", "weight": 0.7}
 ]
}
