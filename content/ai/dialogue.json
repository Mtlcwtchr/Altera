 "initiation": {
  "_doc": "Диалог всегда начинает обычный ИИ (Utility→HTN), в т.ч. с персонажем игрока. Агент не нужен ни для начала, ни для ведения; он может подключиться позже (agent_join).",
  "chain": "социальная цель Utility (B: socialize, ask_help, trade, warn, recruit, complain, court, teach…) → задача HTN talk_to(<char>) → взаимодействие start_dialog{intent} → план dialog_plans[intent] (AGENT_API §3.4)",
  "intents": [
   "small_talk",
   "ask_favor",
   "propose_trade",
   "share_news",
   "warn",
   "confront",
   "court",
   "recruit",
   "offer_teaching",
   "report",
   "from_hint"
  ],
  "intent_aliases": {
   "_doc": "намерения из примеров AGENT_API §3.4",
   "socialize": "small_talk",
   "ask_help": "ask_favor",
   "trade": "propose_trade",
   "complain": "confront",
   "teach": "offer_teaching"
  },
  "triggers": [
   {
    "id": "need_help",
    "when": "текущий метод HTN провалился, а у знакомого есть нужное (has/knows)",
    "plan": "ask_favor"
   },
   {
    "id": "hungry_no_food",
    "when": "need:hunger<0.3 и home:meal<1, рядом знакомый с едой",
    "plan": "ask_favor"
   },
   {
    "id": "has_surplus",
    "when": "избыток предмета и знает, кому он нужен",
    "plan": "propose_trade"
   },
   {
    "id": "fresh_news",
    "when": "в памяти свежее значимое событие/слух, рядом знакомый",
    "plan": "share_news"
   },
   {
    "id": "grievance",
    "when": "нарушенное обязательство/обида к цели выше порога",
    "plan": "confront"
   },
   {
    "id": "debt_due",
    "when": "срок долга/обещания цели истёк",
    "plan": "confront"
   },
   {
    "id": "attraction",
    "when": "rel:affinity высока, оба взрослые, свободны (или черта)",
    "plan": "court"
   },
   {
    "id": "recruit",
    "when": "лидер/основатель и цель без поселения или недовольна",
    "plan": "recruit"
   },
   {
    "id": "teach_offer",
    "when": "родитель/мастер и цель без знания",
    "plan": "offer_teaching"
   },
   {
    "id": "lonely",
    "when": "need:social<0.3",
    "plan": "small_talk"
   },
   {
    "id": "danger_seen",
    "when": "видел угрозу (зверь, набег, пожар) рядом с знакомым",
    "plan": "warn"
   },
   {
    "id": "witness_crime",
    "when": "видел преступление цели",
    "plan": "confront|report"
   },
   {
    "id": "agent_hint",
    "when": "set_goal_hint/queue_task из прошлого диалога с агентом",
    "plan": "from_hint"
   }
  ],
  "approach": [
   "NPC идёт к цели (Move) и открывает сессию актом greet или сразу первым актом плана (при срочности)",
   "Если цель под PlayerController: игрок получает входящий разговор (реплика NPC + меню ответов); проигнорировать = ответ ignore",
   "Если цель под AiController: её ИИ принимает/отклоняет вход по response_eval (занят, вражда)"
  ],
  "world_runs": "Мир не ставится на паузу (ответ пользователя 18.11). Ожидание ответа ограничено reply_timeout тиков; молчание = refuse с причиной «не ответил», NPC запоминает, меню у игрока гаснет",
  "reply_timeout_ticks": {
   "player": 3,
   "npc": 1
  },
  "interrupts": "критичная нужда, угроза, зов — сессия закрывается с причиной interrupted; невыполненный план разговора можно продолжить позже (цель talk_to с бонусом)"
 },
 "dialog_plans": {
  "_doc": "Планы разговора = методы HTN из речевых актов. Шаг: {act, content}; ветки по ответу собеседника (on: accept/refuse/bargain/ask/default). NPC перепланирует шаг, если ответ неожиданный (например, игрок сам предложил сделку). Ветка end закрывает сессию farewell.",
  "plans": [
   {
    "id": "ask_favor",
    "steps": [
     {
      "act": "greet"
     },
     {
      "act": "inform",
      "content": "need:<нужда> | plan:<провалившийся метод>",
      "_doc": "объясняет, зачем пришёл"
     },
     {
      "act": "request",
      "content": "interaction:<что нужно>",
      "on": {
       "accept": "thank→end",
       "refuse": "next",
       "bargain": "accept_if_fair",
       "ask": "inform_reason"
      }
     },
     {
      "act": "offer",
      "content": "terms:<что может дать взамен>",
      "if": "has_something_to_offer",
      "on": {
       "accept": "thank→end",
       "refuse": "next",
       "bargain": "bargain_until_patience"
      }
     },
     {
      "act": "persuade",
      "if": "trait:persistent|need critical",
      "on": {
       "accept": "thank→end",
       "default": "farewell→end"
      }
     }
    ]
   },
   {
    "id": "propose_trade",
    "steps": [
     {
      "act": "greet"
     },
     {
      "act": "offer",
      "content": "terms",
      "on": {
       "accept": "end",
       "bargain": "bargain_until_patience",
       "refuse": "ask_what_wanted"
      }
     },
     {
      "act": "ask",
      "content": "item:что нужно собеседнику",
      "on": {
       "inform": "offer_again",
       "default": "farewell→end"
      }
     }
    ]
   },
   {
    "id": "share_news",
    "steps": [
     {
      "act": "greet"
     },
     {
      "act": "inform",
      "content": "event|rumor"
     },
     {
      "act": "ask",
      "content": "event|rumor",
      "_doc": "в ответ ждёт новостей",
      "on": {
       "default": "farewell→end"
      }
     }
    ]
   },
   {
    "id": "confront",
    "steps": [
     {
      "act": "accuse",
      "content": "event|commitment",
      "on": {
       "apologize": "accept→end",
       "confess": "request_compensation",
       "refuse": "next",
       "lie": "detect_lie_roll"
      }
     },
     {
      "act": "request",
      "content": "interaction:возмещение",
      "on": {
       "accept": "end",
       "refuse": "next"
      }
     },
     {
      "act": "threaten",
      "if": "trait:vengeful|rel:fear(target)<0.2",
      "content": "terms{if: возмещение, then: brawl|accuse_publicly}",
      "on": {
       "default": "end"
      }
     }
    ]
   },
   {
    "id": "court",
    "steps": [
     {
      "act": "greet"
     },
     {
      "act": "praise",
      "tone": "flirtatious",
      "on": {
       "thank": "next",
       "refuse": "farewell→end"
      }
     },
     {
      "act": "offer",
      "content": "interaction:share_meal|embrace",
      "on": {
       "accept": "end",
       "refuse": "farewell→end"
      }
     },
     {
      "act": "offer",
      "content": "interaction:propose_marriage",
      "if": "rel:affinity>0.6 и встречи≥N"
     }
    ]
   },
   {
    "id": "recruit",
    "steps": [
     {
      "act": "greet"
     },
     {
      "act": "inform",
      "content": "place:поселение | plan:что есть у нас"
     },
     {
      "act": "persuade",
      "content": "interaction:invite_to_settle",
      "on": {
       "accept": "promise→end",
       "bargain": "offer_terms",
       "refuse": "farewell→end"
      }
     }
    ]
   },
   {
    "id": "offer_teaching",
    "steps": [
     {
      "act": "offer",
      "content": "interaction:learn_<знание>",
      "on": {
       "accept": "end",
       "refuse": "end"
      }
     }
    ]
   },
   {
    "id": "small_talk",
    "steps": [
     {
      "act": "greet"
     },
     {
      "act": "inform",
      "content": "любая тема с наибольшим интересом обоих"
     },
     {
      "act": "ask",
      "content": "plan|feeling",
      "on": {
       "default": "farewell→end"
      }
     }
    ]
   },
   {
    "id": "warn",
    "steps": [
     {
      "act": "inform",
      "content": "event|place|person: угроза",
      "tone": "neutral",
      "_doc": "без приветствия при срочности"
     },
     {
      "act": "request",
      "content": "interaction:flee|travel_to|defend_other",
      "on": {
       "accept": "end",
       "default": "farewell→end"
      }
     }
    ]
   },
   {
    "id": "report",
    "steps": [
     {
      "act": "accuse",
      "listener": "office[judge]|leader",
      "content": "event:преступление",
      "_doc": "идёт не к виновному, а к власти"
     }
    ]
   },
   {
    "id": "from_hint",
    "_doc": "План собирается из цели, поставленной агентом ранее (queue_task/set_goal_hint) — агент так «продолжает» разговор без своего присутствия"
   }
  ],
  "player_initiative": "Если игрок в ответ сам выбирает другой акт (например, offer вместо ответа), NPC оценивает его как обычный входящий акт; план разговора продолжает или бросает по новому баллу цели"
 },
 "agent_join": {
  "_doc": "Агент подключается к уже идущему разговору (начатому ИИ), подстраивается и может уйти — без разрыва.",
  "when": [
   "в любой момент: игрок включил агента или клиент Agent API подписан на персонажа",
   "только на границе акта (не посреди реплики)"
  ],
  "handover_to_agent": {
   "session_history": "все акты и тексты сессии",
   "opening": "AGENT_API §3.4: {initiator, intent, goal, acts}; агент обязан продолжать opening.intent",
   "dialog_plan": "план и номер шага",
   "listener_graph": "get_character_graph NPC",
   "rule": "агент продолжает цель разговора NPC или меняет её только через ai_mods с причиной; уже совершённые акты и обязательства не отменяются"
  },
  "handover_back": "агент ушёл/таймаут → BuiltinProvider и план разговора продолжают с текущего шага (или перепланируют по новому состоянию)",
  "player_input": "с агентом игрок пишет свободный текст; если агент отключился посреди сессии — сразу меню «акт+тема» на той же сессии"
 },
 "response_eval": {
  "_doc": "Как ИИ слушателя выбирает ответ (BuiltinProvider и ИИ NPC в любом режиме). Каждый допустимый ответ получает балл как цель Utility; выбор — взвешенный среди top_k от seed слушателя.",
  "accept_score": [
   {
    "input": "goal_value(listener,content)",
    "weight": 1.0,
    "_doc": "насколько содержание полезно слушателю (его нужды/цели)"
   },
   {
    "input": "cost(listener,content)",
    "weight": -0.8,
    "_doc": "время, ресурсы, риск для слушателя"
   },
   {
    "input": "rel:affinity(listener->speaker)",
    "weight": 0.6
   },
   {
    "input": "rel:trust(listener->speaker)",
    "weight": 0.5,
    "_doc": "для promise/offer с отложенным исполнением"
   },
   {
    "input": "rel:fear(listener->speaker)",
    "weight": 0.5,
    "_doc": "для threaten/command"
   },
   {
    "input": "authority(speaker,listener)",
    "weight": 0.7,
    "_doc": "только command"
   },
   {
    "input": "obligation(listener->speaker)",
    "weight": 0.6,
    "_doc": "долг, обещание, вассалитет, родство"
   },
   {
    "input": "legal_penalty(listener,content)",
    "weight": -1.0,
    "_doc": "traits.legal_penalty × config.legal_base"
   },
   {
    "input": "trait_bias(listener,act,content)",
    "weight": 1.0
   },
   {
    "input": "witness_pressure",
    "weight": 0.3,
    "_doc": "отказ при свидетелях дороже/дешевле по культуре"
   },
   {
    "input": "agent_modifiers(listener)",
    "weight": 1.0,
    "_doc": "adjust_weight из Agent API, в границах config.modifier_bounds"
   }
  ],
  "refuse_score": "const 0.5 + rel:enmity×0.6 + current_goal_priority×0.5",
  "bargain_if": "accept_score в [refuse_score-0.15, refuse_score) и content.kind=terms",
  "ask_if": "слушатель не знает темы или не понял (нет общего языка)",
  "refusal_reason": "топ-1 отрицательное соображение из трассы → fact в акте refuse",
  "player_listener": "если слушатель под PlayerController — меню ответов с подсветкой того, что выбрал бы ИИ"
 },
 "menu": {
  "_doc": "Меню диалога без агента: собеседник → группа → (акт, тема) → тон. Строится из каталога и знаний говорящего, не из списка тем.",
  "groups": [
   {
    "id": "do_together",
    "name_key": "ui.dialogue_menu.do_together",
    "source": "interactions с target=character и непустым speech",
    "acts_from": "interaction.speech",
    "_doc": "«предложить поесть вместе», «попросить научить готовить», «приказать охранять»"
   },
   {
    "id": "talk_about",
    "name_key": "ui.dialogue_menu.talk_about",
    "source": "topic_kinds по знаниям говорящего",
    "acts_from": "topic_kinds[].acts"
   },
   {
    "id": "feelings",
    "name_key": "ui.dialogue_menu.feelings",
    "source": "acts group=expressive"
   },
   {
    "id": "deal",
    "name_key": "ui.dialogue_menu.deal",
    "source": "trade|lend|hire|propose_marriage|make_peace",
