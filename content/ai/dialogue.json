 "legal_rules": {
  "_doc": "Условные теги взаимодействий перенесены в каталог (legal_if/legal_unless, AI_DATA_SCHEMA_EXT §8). Здесь — только правила речевых актов. Закон меняет цену, вариант не исчезает.",
  "add": [
   {
    "act": "lie",
    "tag": "fraud",
    "if": "content in open_deal"
   },
   {
    "act": "accuse",
    "tag": "false_accusation",
    "if": "truth=speaker_believes_false"
   },
   {
    "act": "threaten",
    "tag": "extortion",
    "if": "terms.if gives item to speaker"
   },
   {
    "act": "insult",
    "tag": "lese_majeste",
    "if": "rank(listener)>rank(speaker)+1"
   }
  ],
  "detection": "visibility public — все в радиусе восприятия; private — только участники; secret — проверка заметить по каждому свидетелю"
 },
 "agent_projection": {
  "_doc": "Формат вывода AgentProvider (детали транспорта — задача D, agent_api/). Механика берётся только из acts; text — оболочка.",
  "utterance": {
   "speaker": "id",
   "text": "string (≤ 600 символов)",
   "acts": [
    {
     "act": "<acts.id>",
     "content": {
      "kind": "interaction|fact|terms|commitment|none",
      "ref": "id",
      "params": {}
     },
     "tone": "<menu.tones>",
     "truth": "true|false (только lie)"
    }
   ],
   "ai_mods": [
    {
     "op": "adjust_weight|queue_task|set_goal_hint",
     "args": {},
     "reason": "string"
    }
   ]
  },
  "rules": [
   "acts пусто → реплика без механики (small talk), трактуется как inform без содержания",
   "каждый act проверяется по get_options(session, speaker); недопустимый отклоняется с причиной, остальное исполняется",
   "player free text → агент сводит к acts игрока; при неоднозначности агент обязан спросить уточнение (ask), а не угадывать дорогие акты (command, threaten, attack-интеракции)",
   "ai_mods только для NPC-собеседника и только как следствие актов этой реплики; reason обязателен и пишется в трассу",
   "таймаут агента → BuiltinProvider даёт реплику по тем же правилам"
  ]
 },
 "aliases": {
  "_doc": "Имена актов в AGENT_API v0.1 §4.3 → id в этом файле (свести к одному при реализации)",
  "agree": "accept",
  "haggle": "bargain"
 },
