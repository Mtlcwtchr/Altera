{ "_doc": "Interaction catalog (AI_DATA_SCHEMA.md §8): one entry serves the planner, the player and every NPC alike. MVP subset: food, sleep, warmth. For continuous interactions eff is applied every tick.",
  "interactions": [
    { "id": "gather_berries", "category": "work", "target": "object:berry_bush",
      "pre": ["knows:foraging", "target_stock:berries>=2"],
      "eff": ["has:berries+2", "target_stock:berries-2", "skill:foraging+0.01", "body:fatigue+0.01"],
      "duration": 3, "cost": 3, "fsm": "Work", "reserve": true, "speech": ["offer", "request"] },
    { "id": "gather_wood", "category": "work", "target": "object:tree", "pre": ["!age:child"],
      "eff": ["has:wood+2", "body:fatigue+0.02"], "duration": 4, "cost": 4, "fsm": "Work", "reserve": true },
    { "id": "cook_meal", "category": "work", "target": "object:hearth",
      "pre": ["knows:cooking", "has:berries>=3", "has:wood>=1", "target_owner:family"],
      "eff": ["has:berries-3", "has:wood-1", "has:meal+2", "skill:cooking+0.01"],
      "duration": 4, "cost": 4, "fsm": "Work", "reserve": true },
    { "id": "take_meal", "category": "household", "target": "object:storage",
      "pre": ["target_stock:meal>=1", "target_owner:family"],
      "eff": ["has:meal+1", "target_stock:meal-1"], "duration": 1, "cost": 1, "fsm": "Interact" },
    { "id": "store_meal", "category": "household", "target": "object:storage",
      "pre": ["has:meal>=1", "target_owner:family"],
      "eff": ["has:meal-1", "target_stock:meal+1"], "duration": 1, "cost": 1, "fsm": "Interact", "goap": false },
    { "id": "steal_meal", "category": "economy", "target": "object:storage",
      "pre": ["target_stock:meal>=1", "target_owner:other"],
      "eff": ["has:meal+1", "target_stock:meal-1", "moodlet:stole", "memory:stole_food"],
      "duration": 1, "cost": 2, "fsm": "Interact", "legal": ["theft"], "visibility": "secret" },
    { "id": "eat_meal", "category": "household", "target": "self", "pre": ["has:meal>=1"],
      "eff": ["has:meal-1", "need:hunger+0.45", "moodlet:ate_meal"], "duration": 2, "cost": 1, "fsm": "Eat",
      "goap": false },
    { "id": "eat_berries", "category": "household", "target": "self", "pre": ["has:berries>=2"],
      "eff": ["has:berries-2", "need:hunger+0.22", "moodlet:ate_raw"], "duration": 1, "cost": 1, "fsm": "Eat",
      "goap": false },
    { "id": "sleep_bed", "category": "household", "target": "object:bed", "pre": ["target_owner:family"],
      "eff": ["need:energy+0.022", "body:fatigue-0.02", "moodlet:slept_bed"],
      "continuous": true, "until": "need:energy>=0.97", "duration": 60, "cost": 1, "fsm": "Sleep",
      "reserve": true, "goap": false },
    { "id": "sleep_ground", "category": "household", "target": "self",
      "eff": ["need:energy+0.014", "body:fatigue-0.01", "moodlet:slept_rough"],
      "continuous": true, "until": "need:energy>=0.9", "duration": 72, "cost": 3, "fsm": "Sleep", "goap": false },
    { "id": "warm_at_hearth", "category": "household", "target": "object:hearth",
      "eff": ["need:warmth+0.04", "moodlet:warm_hearth"], "continuous": true, "until": "need:warmth>=0.95",
      "duration": 18, "cost": 1, "fsm": "Warm", "goap": false },
    { "id": "huddle", "category": "household", "target": "self", "eff": ["need:warmth+0.015"],
      "continuous": true, "until": "need:warmth>=0.7", "duration": 24, "cost": 2, "fsm": "Warm", "goap": false },
    { "id": "idle_wander", "category": "household", "target": "self", "duration": 3, "cost": 0, "fsm": "Loiter",
      "goap": false },
    { "_doc": "Social catalog, interpreter stage 2: parsed and validated, run by the dialogue layer (step 4).",
      "id": "give_item", "category": "economy", "target": "character",
      "params": { "item": { "type": "item", "of": ["berries", "wood", "meal"] } },
      "pre": ["has:$item>=1"], "eff": ["has:$item-1", "t.has:$item+1", "rel_back:affinity+0.04"],
      "duration": 1, "cost": 1, "fsm": "Interact", "speech": ["offer"] },
    { "id": "lend_item", "category": "economy", "target": "character",
      "params": { "item": { "type": "item", "of": ["berries", "wood", "meal"] } },
      "pre": ["has:$item>=1", "rel:trust>=0.2"],
      "terms": { "give": {"$item": 1}, "take": {"$item": 1}, "due": 288, "commitment": "repay_debt",
                 "on_breach": ["rel:trust-0.3", "t.reputation:honesty-0.1"] },
      "duration": 1, "cost": 1, "fsm": "Talk", "speech": ["offer", "promise"] },
    { "id": "teach_skill", "category": "knowledge", "target": "character",
      "params": { "skill": { "type": "skill", "of": ["foraging", "cooking"] } },
      "pre": ["skill:$skill>=0.5", "t.skill:$skill<0.5", "!t.age:elder"],
      "chance": { "base": 0.4, "skill": "$skill", "per_skill": 0.5 },
      "eff": ["t.skill:$skill+0.05", "t.moodlet:learned", "rel_back:respect+0.05"],
      "on_fail": ["rel_back:respect-0.01"],
      "duration": 6, "cost": 3, "fsm": "Talk", "speech": ["offer", "request"] },
    { "id": "chat", "category": "social", "target": "character", "pre": ["!t.need:energy<0.1"],
      "eff": ["rel:familiarity+0.03", "rel_back:familiarity+0.03", "moodlet:chatted", "t.moodlet:chatted"],
      "duration": 2, "cost": 1, "fsm": "Talk", "speech": ["greet", "smalltalk", "gossip"] },
    { "id": "brawl", "category": "violence", "target": "character", "pre": ["rel:enmity>=0.5", "!t.age:child"],
      "combat": { "attack_skill": "fighting", "defense_skill": "fighting", "damage": [0.05, 0.25], "lethal": false,
                  "outcomes": { "win": ["moodlet:won_fight", "reputation:valor+0.03", "t.moodlet:wounded"],
                                "lose": ["moodlet:wounded", "t.moodlet:won_fight"],
                                "flee": ["reputation:valor-0.02"] } },
      "risk": [ { "id": "broken_bone", "p": 0.05, "eff": ["body:health-0.2"] } ],
      "eff": ["rel_back:enmity+0.1", "rel_back:fear+0.05", "memory:fought"],
      "duration": 3, "cost": 5, "fsm": "Fight", "legal": ["assault"], "visibility": "public",
      "speech": ["threaten"] }
  ]
}
