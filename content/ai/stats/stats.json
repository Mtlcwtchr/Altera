  "memory": "attr_base.intellect + noise(0, 0.08)",
  "wisdom": "0.5*attr_base.perception + 0.5*attr_base.intellect + noise(0, 0.08)",
  "composure": "attr_base.willpower + noise(0, 0.08)",
  "attunement": "noise(0.2, 0.08)"
 },
