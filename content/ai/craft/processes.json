{
 "_doc": "Processes (gdd crafting v0.2 §4, §16). op: shape (the work piece changes shape/properties) | heat (work piece + co-inputs over a heat level) | blend (inputs merge into one) | join (pieces become an assembly) | soak (work piece takes up a liquid). requires: tool (any-of tool tags; none = bare hands), station (any-of station tags), heat_min (a station giving at least this level must be at hand), clean (hygiene matters). inputs: slots {slot, shape, tag (any-of), either (shape OR tag), p (craft-expr constraints on the piece), optional, min, max}. difficulty: base + add (craft-expr over the work piece). shape_map: from -> allowed target shapes. transform: property -> craft-expr (x = old value, q = step quality, heat, even, hygiene). flaws: {id, p, when} craft-expr. set_state, to_material, extract, marks (profile tags), fixes (flaws a good step removes), reacts (check reacts.json), risky (catastrophes possible), modes, no_air_modes. skill_by: the skill by the work piece's tag (repair). chain_in/chain_out: hints only. See doc/design/CRAFT_EXPR.md.",
 "processes": [
  {"id": "heat", "op": "heat", "skill": "cooking", "skill_by": [{"tag": "metal", "skill": "smithing"}, {"tag": "metal_raw", "skill": "smithing"}, {"tag": "ore", "skill": "smithing"}, {"tag": "clay", "skill": "pottery"}, {"tag": "stone", "skill": "building"}, {"tag": "wood", "skill": "firemaking"}],
   "requires": {"station": ["hearth", "oven", "forge", "campfire", "furnace"], "heat_min": 1},
   "inputs": [{"slot": "work", "shape": ["any"]}, {"slot": "with", "optional": true, "max": 3, "shape": ["any"]}],
   "time": 3, "difficulty": {"base": 0.25},
   "transform": {"moisture": "heat>=2 ? x*0.4 : x*0.8"},
   "flaws": [
    {"id": "burnt", "p": "tag(food)*(heat>=3 ? 0.8 : (heat>=2 ? 0.25 : 0.05))*(1.2-q)"},
    {"id": "raw", "p": "tag(food)*0.4*(1-q)*(1-even)", "when": "heat<=2"},
    {"id": "crack", "p": "tag(clay)*0.35*(1-q)*(1-even)", "when": "heat>=2"}
   ],
   "risk": [{"id": "burn_hand", "p": 0.02, "eff": ["body:health-0.02"]}],
   "modes": ["roast", "boil", "bake", "fire", "calcine", "char", "smoke"], "no_air_modes": ["char"],
   "marks": ["heat"], "reacts": true, "ordered": true, "chain_in": ["any"], "chain_out": ["any"]},

  {"id": "smelt", "op": "heat", "skill": "smithing",
   "requires": {"station": ["furnace", "forge"], "heat_min": 3},
   "inputs": [{"slot": "ore", "tag": ["ore"]}, {"slot": "fuel", "tag": ["carbon", "fuel"], "max": 2}],
   "time": 8, "difficulty": {"base": 0.45, "add": "0.3*(1-purity)"},
   "transform": {"purity": "min(1, x*(0.7+0.6*q))"},
   "flaws": [{"id": "impure", "p": "0.5*(1-q)"}],
   "risk": [{"id": "burn_hand", "p": 0.04, "eff": ["body:health-0.05"]}],
   "risky": true, "ordered": true, "chain_in": ["lump"], "chain_out": ["lump"]},

  {"id": "cut", "op": "shape", "skill": "carpentry", "skill_by": [{"tag": "hide", "skill": "sewing"}],
   "requires": {"tool": ["cutting", "saw"]},
   "inputs": [{"slot": "work", "shape": ["log", "plank", "hide", "sheet", "beam"]}],
   "time": 2, "difficulty": {"base": 0.2, "add": "0.2*hardness"},
   "shape_map": {"log": ["plank", "beam", "stave"], "beam": ["plank", "stave"], "plank": ["stave"], "hide": ["sheet", "strip"], "sheet": ["strip"]},
   "flaws": [{"id": "uneven", "p": "0.3*(1-q)"}],
   "risk": [{"id": "cut_hand", "p": 0.03, "eff": ["body:health-0.03"]}]},

  {"id": "carve", "op": "shape", "skill": "carpentry", "skill_by": [{"tag": "bone", "skill": "toolmaking"}],
   "requires": {"tool": ["cutting"]},
   "inputs": [{"slot": "work", "shape": ["plank", "beam", "stave", "log", "bone"]}],
   "time": 4, "difficulty": {"base": 0.35, "add": "0.25*hardness"},
   "shape_map": {"plank": ["handle", "spoon_raw", "trencher_raw", "spade_raw", "figure_raw"], "beam": ["shaft", "handle"], "stave": ["bow_stave", "shaft", "handle", "spindle_raw", "fork_raw"], "log": ["bowl_raw", "handle", "shaft", "cup_raw", "spoon_raw", "trencher_raw", "spindle_raw", "spade_raw", "fork_raw", "figure_raw"], "bone": ["needle_blank", "flute_raw", "comb_raw", "dice_raw", "charm_raw", "cup_raw"]},
   "flaws": [{"id": "crack", "p": "0.25*(1-q)", "when": "toughness<0.3"}, {"id": "uneven", "p": "0.2*(1-q)"}],
   "risk": [{"id": "cut_hand", "p": 0.02, "eff": ["body:health-0.02"]}]},

  {"id": "knap", "op": "shape", "skill": "knapping",
   "inputs": [{"slot": "work", "shape": ["lump"], "tag": ["knappable"]}],
   "time": 2, "difficulty": {"base": 0.35},
   "shape_map": {"lump": ["blade", "blank_head"]},
   "flaws": [{"id": "crack", "p": "0.3*(1-q)"}],
   "risk": [{"id": "cut_hand", "p": 0.03, "eff": ["body:health-0.02"]}]},

  {"id": "hammer", "op": "shape", "skill": "smithing",
   "requires": {"tool": ["striking"], "station": ["anvil"], "heat_min": 2, "tool_hardness_ge": "hardness*0.8"},
   "inputs": [{"slot": "work", "shape": ["lump", "bar", "plate", "bar_thin"], "tag": ["metal", "metal_raw"], "p": {"workable": ">=0.3"}}],
   "time": 4, "difficulty": {"base": 0.35, "add": "0.3*hardness - 0.2*purity"},
   "shape_map": {"lump": ["bar"], "bar": ["bar", "blank_blade", "blank_head", "plate", "bar_thin", "wire", "nail", "rivet", "sickle_blade"], "plate": ["blank_helm", "sheet_metal", "cauldron_raw", "hoe_blade", "comb_raw", "charm_raw"], "bar_thin": ["wire"]},
   "transform": {"purity": "min(1, x + 0.08*q)", "hardness": "min(1, x + 0.02)"},
   "flaws": [{"id": "crack", "p": "0.3*(1-q)", "when": "toughness<0.2"}, {"id": "uneven", "p": "0.4*(1-q)"}],
   "fixes": ["impure"],
   "risk": [{"id": "burn_hand", "p": 0.03, "eff": ["body:health-0.03"]}]},

  {"id": "quench", "op": "shape", "skill": "smithing",
   "requires": {"station": ["quench_tub"], "heat_min": 3},
   "inputs": [{"slot": "work", "shape": ["blank_blade", "blade", "blank_head", "blank_helm", "bar"], "tag": ["metal"]}],
   "time": 1, "difficulty": {"base": 0.5},
   "set_state": "quenched",
   "flaws": [{"id": "crack", "p": "tag(steel)*0.4*(1-q)"}, {"id": "brittle", "p": "0.3*(1-q)"}]},

  {"id": "link", "op": "shape", "skill": "smithing",
   "requires": {"tool": ["tongs"]},
   "inputs": [{"slot": "work", "shape": ["wire"], "tag": ["metal"], "max": 4}],
   "time": 24, "difficulty": {"base": 0.4},
   "shape_map": {"wire": ["ring_mail"]},
   "flaws": [{"id": "loose_joint", "p": "0.3*(1-q)"}]},

  {"id": "grind", "op": "shape", "skill": "smithing", "skill_by": [{"tag": "stone", "skill": "toolmaking"}],
   "requires": {"tool": ["whetstone", "grit"], "station": ["grindstone", "bench"]},
   "inputs": [{"slot": "work", "shape": ["blank_blade", "blade", "blank_head", "sheet_metal", "lump", "bar_thin"]}],
   "time": 3, "difficulty": {"base": 0.3},
   "shape_map": {"blank_blade": ["blade"], "lump": ["whet_blank"]},
   "transform": {"edge": "max(x, min(mat.edge + 0.25, x + 0.25*q))"},
   "flaws": [{"id": "uneven", "p": "0.25*(1-q)"}],
   "fixes": ["uneven"],
   "modes": ["hone", "polish", "sharpen"]},

  {"id": "mill", "op": "shape", "skill": "cooking",
   "requires": {"station": ["mortar", "quern"]},
   "inputs": [{"slot": "work", "tag": ["grain"]}],
   "time": 3, "difficulty": {"base": 0.1},
   "shape_map": {"lump": ["powder"]},
   "to_material": "flour"},

  {"id": "soak", "op": "soak", "skill": "cooking", "skill_by": [{"tag": "bark", "skill": "fiber_working"}, {"tag": "grain", "skill": "brewing"}],
   "requires": {"station": ["tub", "pot", "bench"]},
   "inputs": [{"slot": "work", "shape": ["any"]}, {"slot": "liquid", "tag": ["liquid"], "max": 3}],
   "time": 6, "difficulty": {"base": 0.15},
   "transform": {"moisture": "min(1, x + 0.4)"},
   "extract": "water_cold", "marks": ["soaked"],
   "modes": ["steep", "malt", "ret", "brine"]},

  {"id": "dry", "op": "shape", "skill": "cooking", "skill_by": [{"tag": "herb", "skill": "herbalism"}, {"tag": "clay", "skill": "pottery"}],
   "requires": {"station": ["rack", "hearth", "bench"]},
   "inputs": [{"slot": "work", "shape": ["any"]}],
   "time": 12, "difficulty": {"base": 0.1},
   "transform": {"moisture": "max(0, x - 0.5)"},
   "flaws": [{"id": "rot", "p": "tag(food)*0.3*(1-q)", "when": "moisture>0.5"}],
   "fixes": ["damp"], "marks": ["dried"]},

  {"id": "ferment", "op": "blend", "skill": "brewing",
   "requires": {"station": ["vat", "jar", "barrel"], "clean": true},
   "inputs": [{"slot": "base", "tag": ["sweet", "grain", "fruit", "brewable", "dairy", "liquid"], "max": 3}, {"slot": "agent", "tag": ["yeast"], "optional": true}],
   "time": 144, "difficulty": {"base": 0.35},
   "flaws": [{"id": "tainted", "p": "0.4*(1-q)*(1-hygiene)"}],
   "reacts": true, "ordered": true, "modes": ["brew", "pickle", "sour"], "marks": ["fermented"]},

  {"id": "twist", "op": "shape", "skill": "spinning", "skill_by": [{"tag": "bark", "skill": "fiber_working"}],
   "inputs": [{"slot": "work", "shape": ["fiber_raw", "strip", "strand", "cord"], "p": {"fiber": ">=0.3"}}],
   "time": 3, "difficulty": {"base": 0.2},
   "shape_map": {"fiber_raw": ["strand"], "strip": ["strand"], "strand": ["cord"], "cord": ["rope"]},
   "transform": {"fiber": "min(1, x + 0.1*q)", "toughness": "min(1, x + 0.08*q)"},
   "flaws": [{"id": "uneven", "p": "0.3*(1-q)"}]},

  {"id": "weave", "op": "shape", "skill": "weaving",
   "requires": {"station": ["loom", "frame"]},
   "inputs": [{"slot": "work", "shape": ["strand", "cord", "withy"], "p": {"fiber": ">=0.4"}, "max": 6}],
   "time": 8, "difficulty": {"base": 0.35},
   "shape_map": {"strand": ["cloth"], "cord": ["net"], "withy": ["basket_raw"]},
   "flaws": [{"id": "uneven", "p": "0.3*(1-q)"}, {"id": "loose_joint", "p": "0.2*(1-q)"}]},

  {"id": "sew", "op": "shape", "skill": "sewing",
   "requires": {"tool": ["needle"]},
   "inputs": [{"slot": "work", "shape": ["cloth", "sheet", "hide"], "max": 3}, {"slot": "thread", "shape": ["strand", "cord"]}],
   "time": 6, "difficulty": {"base": 0.35},
   "shape_map": {"cloth": ["garment_raw", "padded_raw", "pouch_raw", "doll_raw"], "sheet": ["garment_raw", "pouch_raw", "boot_raw", "armor_raw"], "hide": ["armor_raw", "pouch_raw", "boot_raw"]},
   "flaws": [{"id": "loose_joint", "p": "0.3*(1-q)"}]},

  {"id": "join", "op": "join", "skill": "carpentry", "skill_by": [{"tag": "metal", "skill": "smithing"}],
   "inputs": [{"slot": "a", "shape": ["any"]}, {"slot": "b", "shape": ["any"]}, {"slot": "binder", "optional": true, "shape": ["strand", "cord", "wire", "nail", "rivet", "strip"], "tag": ["adhesive"], "either": true}],
   "time": 3, "difficulty": {"base": 0.3},
   "assemble": [{"a": "stave", "b": "stave", "binder": true, "to": "cask_raw"}],
   "flaws": [{"id": "loose_joint", "p": "0.35*(1-q)"}]},

  {"id": "mix", "op": "blend", "skill": "cooking", "skill_by": [{"tag": "herb", "skill": "herbalism"}, {"tag": "mineral", "skill": "building"}],
   "requires": {"station": ["bench", "pot", "mortar"]},
   "inputs": [{"slot": "a", "shape": ["any"]}, {"slot": "b", "shape": ["any"], "max": 6}],
   "time": 2, "difficulty": {"base": 0.15},
   "reacts": true, "ordered": true, "modes": ["knead", "grind_herbs", "stir"]},

  {"id": "mould", "op": "shape", "skill": "pottery",
   "requires": {"station": ["wheel", "bench"]},
   "inputs": [{"slot": "work", "tag": ["clay", "wax", "fat"], "p": {"workable": ">=0.4"}}],
   "time": 4, "difficulty": {"base": 0.3},
   "shape_map": {"lump": ["vessel_raw", "bowl_raw", "brick_raw", "tile_raw", "candle_raw", "candlestick_raw", "pipe_raw", "whistle_raw"]},
   "flaws": [{"id": "crack", "p": "0.3*(1-q)", "when": "moisture<0.3"}]},

  {"id": "tan", "op": "shape", "skill": "tanning",
   "requires": {"station": ["tanning_pit", "tub"]},
   "inputs": [{"slot": "work", "tag": ["hide"]}, {"slot": "agent", "tag": ["bark", "alkali"]}],
   "time": 48, "difficulty": {"base": 0.35},
   "to_material": "leather",
   "flaws": [{"id": "rot", "p": "0.3*(1-q)"}]},

  {"id": "alloy", "op": "blend", "skill": "smithing",
   "requires": {"station": ["furnace", "forge"], "heat_min": 3},
   "inputs": [{"slot": "a", "tag": ["metal"], "max": 5}, {"slot": "b", "tag": ["metal"], "max": 5}],
   "time": 6, "difficulty": {"base": 0.5},
   "flaws": [{"id": "impure", "p": "0.4*(1-q)"}],
   "reacts": true, "risky": true},

  {"id": "repair", "worth": 0.9, "op": "shape", "skill": "smithing", "skill_by": [{"tag": "hide", "skill": "sewing"}, {"tag": "leather", "skill": "sewing"}, {"tag": "fiber", "skill": "sewing"}, {"tag": "wood", "skill": "carpentry"}],
   "requires": {"tool": ["striking", "needle", "whetstone", "grit"]},
   "inputs": [{"slot": "work", "shape": ["any"], "p": {"wear": ">0"}}],
   "time": 4, "difficulty": {"base": 0.3},
   "transform": {"wear": "max(0, x - 0.1 - 0.4*q)"},
   "fixes": ["loose_joint", "uneven"],
   "flaws": [{"id": "loose_joint", "p": "0.15*(1-q)", "when": "joint<1"}],
   "modes": ["hone", "patch", "rivet", "straighten"]}
 ]
}
